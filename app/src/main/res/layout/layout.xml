<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ECEDAA"
    android:orientation="vertical">

    <TextView
        android:id="@+id/textView"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_marginTop="20dp"
        android:layout_weight=".5"
        android:gravity="center"
        android:text="Whose turn is it?"
        android:textAppearance="@style/TextAppearance.AppCompat.Display2"
        android:textColor="@color/dark_blue" />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_weight="0"
        android:text="Music Picker:"
        android:textAppearance="@style/TextAppearance.AppCompat.Display1"
        android:visibility="gone" />

    <TextView
        android:id="@+id/chosenText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_weight=".1"
        android:gravity="center"
        android:text="Click &quot;Choose...&quot; to find out!"
        android:textAppearance="@style/TextAppearance.AppCompat.Display1"
        android:textColor="#467EBF" />

    <Button
        android:id="@+id/chooseNext"
        android:layout_width="320dp"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:layout_weight=".25"
        android:background="#26C6DA"
        android:text="Choose Next Person"
        android:textAllCaps="false"
        android:textColor="#512DA8"
        android:textSize="20sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginVertical="5dp"
        android:layout_weight=".9"
        android:scrollbarAlwaysDrawVerticalTrack="true">

        <TableLayout
            android:id="@+id/nameTable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_marginVertical="5dp"
            android:layout_weight=".5">

            <TableRow
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:id="@+id/textView6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Name"
                    android:textColor="@color/light_blue"
                    android:textSize="20sp" />

                <Button
                    android:id="@+id/addMore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@color/light_blue"
                    android:text="Add"
                    android:textColor="@color/white" />
            </TableRow>

        </TableLayout>
    </ScrollView>

</LinearLayout>